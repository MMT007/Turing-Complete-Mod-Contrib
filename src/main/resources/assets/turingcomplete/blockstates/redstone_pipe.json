{
  "multipart": [
    { "apply": { "model": "turingcomplete:block/redstone_pipe_center" } },

    { "when": { "pipe_north": "connected" }, "apply": { "model": "turingcomplete:block/redstone_pipe_side", "y": 0 } },
    { "when": { "pipe_south": "connected" }, "apply": { "model": "turingcomplete:block/redstone_pipe_side", "y": 180 } },
    { "when": { "pipe_east": "connected" },  "apply": { "model": "turingcomplete:block/redstone_pipe_side", "y": 90 } },
    { "when": { "pipe_west": "connected" },  "apply": { "model": "turingcomplete:block/redstone_pipe_side", "y": 270 } },
    { "when": { "pipe_up": "connected" },   "apply": { "model": "turingcomplete:block/redstone_pipe_side", "x": 270 } },
    { "when": { "pipe_down": "connected" }, "apply": { "model": "turingcomplete:block/redstone_pipe_side", "x": 90 } }
  ]
}